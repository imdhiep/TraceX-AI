# Frontend environment variables for TraceX-AI
# Copy this file to .env.local and fill in your values

# Set this to the real LightningAI metadata-service URL.
# next.config.js reads this value server-side to configure the /api-gw rewrite proxy,
# then overrides the browser bundle to see /api-gw instead — so the browser never
# makes cross-origin requests and CORS is not an issue.
NEXT_PUBLIC_API_BASE_URL=https://8002-XXXXXXXXXXXXXXXXXX.cloudspaces.litng.ai/api/v1
NEXT_PUBLIC_SEARCH_API_BASE_URL=https://8003-XXXXXXXXXXXXXXXXXX.cloudspaces.litng.ai/api/v1

# For local development (no LightningAI URL):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8002/api/v1
# NEXT_PUBLIC_SEARCH_API_BASE_URL=http://localhost:8003/api/v1
